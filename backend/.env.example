APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Pada produksi gunakan LOG_STACK=terstruktur agar log berbentuk JSON satu baris
# lengkap dengan tingkat keparahan dan pengenal korelasi (REQ-NF-MNT-007).
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# URL aplikasi frontend (React) — dipakai untuk tautan verifikasi surat dan CORS
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Letak berkas hasil `npm run build`. Dipakai untuk menyajikan kerangka aplikasi
# beserta metadata terisi kepada perayap tanpa JavaScript (REQ-F-SRC-004).
# Bawaannya ../frontend/dist relatif terhadap backend. Selama pengembangan
# berkas itu belum ada, sehingga permintaan halaman dialihkan ke FRONTEND_URL.
# FRONTEND_DIST=/var/www/sidesa/frontend/dist

# Gateway WhatsApp (opsional, DEP-02). Bila kosong, notifikasi cukup lewat surel.
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_TOKEN=

# Tanda tangan elektronik: "internal" memakai spesimen tanda tangan pejabat,
# "psre" mengirim dokumen ke penyelenggara sertifikasi elektronik (REQ-F-SRT-017).
TTE_DRIVER=internal
TTE_PSRE_NAMA="Balai Sertifikasi Elektronik"
TTE_PSRE_URL=
TTE_PSRE_TOKEN=
TTE_PSRE_PASSPHRASE=
TTE_PSRE_TAMPILAN=invisible

# Anti-penyalahgunaan formulir publik (REQ-SW-007): "bawaan" memakai tantangan
# aritmatika tanpa layanan luar, "turnstile" memakai Cloudflare Turnstile,
# "nihil" mematikannya (hanya untuk pengembangan dan uji otomatis).
CAPTCHA_DRIVER=bawaan
CAPTCHA_KEDALUWARSA_MENIT=10
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analitik web yang menghormati privasi (REQ-SW-006). Dihitung sendiri oleh
# sistem tanpa skrip pihak ketiga dan tanpa menyimpan data pribadi.
ANALITIK_AKTIF=true
